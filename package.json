{
  "name": "x207",
  "version": "0.0.0",
  "description": "Mutual credit settlement layer for x402 agent payments on NEAR",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "sdk/packages/*",
    "sdk/apps/*",
    "backend",
    "frontend",
    "solver",
    "agents"
  ],
  "scripts": {
    "bench:solver": "npm run bench:solver -w @x207/solver",
    "check:pins": "node scripts/check-pins.mjs",
    "check:window": "node scripts/check-window.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:numbers": "node scripts/check-numbers.mjs",
    "testnet:epoch": "node scripts/testnet-epoch.mjs",
    "check:links": "node scripts/check-links.mjs",
    "submission:draft": "node scripts/submission-payload.mjs --draft",
    "test:integration": "X207_SANDBOX=1 vitest run",
    "demo:quick": "node scripts/demo-quick.mjs --release-wasm",
    "demo:sandbox": "X207_SANDBOX=1 vitest run --config demo/vitest.config.mts sandbox",
    "demo:mcp": "node scripts/demo-quick.mjs --release-wasm --demo mcp",
    "demo:swarm": "node scripts/demo-quick.mjs --release-wasm --demo swarm",
    "demo:mcp:run": "X207_SANDBOX=1 vitest run --config demo/vitest.config.mts mcp",
    "demo:swarm:run": "X207_SANDBOX=1 vitest run --config demo/vitest.config.mts swarm",
    "demo:business": "X207_SANDBOX=1 vitest run --config demo/vitest.config.mts business",
    "demo:realworld": "X207_SANDBOX=1 vitest run --config demo/vitest.config.mts realworld",
    "demo:marketplace": "X207_SANDBOX=1 vitest run --config demo/vitest.config.mts marketplace",
    "demo:classb": "X207_SANDBOX=1 vitest run --config demo/vitest.config.mts classb",
    "demo:testnet": "DEMO_NETWORK=testnet vitest run --config demo/vitest.config.mts network",
    "demo:mainnet": "DEMO_NETWORK=mainnet vitest run --config demo/vitest.config.mts network"
  },
  "devDependencies": {
    "jsdom": "30.1.3"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "bigint-buffer": false,
    "bufferutil": false,
    "core-js-pure": false,
    "fsevents": false,
    "protobufjs": false,
    "secp256k1": false,
    "utf-8-validate": false
  }
}
