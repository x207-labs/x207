{
  "name": "x207",
  "version": "0.0.0",
  "description": "Mutual credit settlement layer for x402 agent payments on NEAR",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "sdk/packages/*",
    "sdk/apps/*",
    "backend",
    "frontend",
    "solver",
    "agents"
  ],
  "scripts": {
    "check:pins": "node scripts/check-pins.mjs",
    "check:window": "node scripts/check-window.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "submission:draft": "node scripts/submission-payload.mjs --draft",
    "test:integration": "X207_SANDBOX=1 vitest run",
    "demo:sandbox": "X207_SANDBOX=1 vitest run --config demo/vitest.config.ts sandbox",
    "demo:business": "X207_SANDBOX=1 vitest run --config demo/vitest.config.ts business",
    "demo:realworld": "X207_SANDBOX=1 vitest run --config demo/vitest.config.ts realworld",
    "demo:marketplace": "X207_SANDBOX=1 vitest run --config demo/vitest.config.ts marketplace",
    "demo:classb": "X207_SANDBOX=1 vitest run --config demo/vitest.config.ts classb",
    "demo:testnet": "DEMO_NETWORK=testnet vitest run --config demo/vitest.config.ts network",
    "demo:mainnet": "DEMO_NETWORK=mainnet vitest run --config demo/vitest.config.ts network"
  },
  "devDependencies": {
    "jsdom": "30.1.3"
  }
}
