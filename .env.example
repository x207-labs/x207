# Demo accounts (UM-009). Account IDs only. Secret keys never go in this file or in git.
# Copy to .env and fill in. Mainnet funding and signing are done by a human.
X207_NETWORK=mainnet

# Contract account (FX-01). Agent accounts are sub-accounts of it (FX-02).
X207_CIRCLE_ACCOUNT_ID=x207-circle.near
X207_AGENT_TRANSLATOR_ACCOUNT_ID=translator.x207-circle.near
X207_AGENT_SUMMARIZER_ACCOUNT_ID=summarizer.x207-circle.near
X207_AGENT_SCRAPER_ACCOUNT_ID=scraper.x207-circle.near
X207_AGENT_IMAGE_ACCOUNT_ID=image.x207-circle.near
X207_AGENT_CLEANER_ACCOUNT_ID=cleaner.x207-circle.near
X207_AGENT_GPU_ACCOUNT_ID=gpu.x207-circle.near

# Supporting accounts. Names are chosen by the owner when the accounts are made.
X207_KEEPER_ACCOUNT_ID=
X207_SOLVER_ACCOUNT_ID=
X207_FACILITATOR_RELAYER_ACCOUNT_ID=
X207_DAO_MEMBER_ACCOUNT_ID=

# Token (FX-01)
X207_USDT_CONTRACT_ID=usdt.tether-token.near

# Where each account's key is stored on this machine (path to a key file kept outside git).
X207_KEYS_DIR=.keys
