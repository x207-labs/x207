# Variables for the mainnet preflight (scripts/mainnet-preflight.mjs) and the mainnet rehearsals. Names and short comments only, no values.
# Copy to .env.mainnet (ignored by git) and fill in. Account ids only; a secret key never goes in this file.

# The account that holds the circle contract. The six agent accounts below are sub-accounts of it.
X207_CIRCLE_ACCOUNT_ID=
X207_AGENT_TRANSLATOR_ACCOUNT_ID=
X207_AGENT_SUMMARIZER_ACCOUNT_ID=
X207_AGENT_SCRAPER_ACCOUNT_ID=
X207_AGENT_IMAGE_ACCOUNT_ID=
X207_AGENT_CLEANER_ACCOUNT_ID=
X207_AGENT_GPU_ACCOUNT_ID=

# Account of the keeper (finalize, prune_epoch, withdraw_intents_balance).
X207_KEEPER_ACCOUNT_ID=
# Account of the solver (submit_best).
X207_SOLVER_ACCOUNT_ID=
# Account that pays gas for the facilitator (relayer).
X207_FACILITATOR_RELAYER_ACCOUNT_ID=
# A member of the Sputnik DAO council that owns the circle.
X207_DAO_MEMBER_ACCOUNT_ID=

# 1Click API token. The only secret the preflight may read (dry quote). Never print it, never commit it.
ONECLICK_JWT=
# A Base address that receives nothing: the quote is dry. Needed with ONECLICK_JWT for the dry quote.
X207_PREFLIGHT_BASE_ADDRESS=
