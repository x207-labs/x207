[Unit]
Description=x207 read API and indexer of x207-v015.testnet (EVM agents, auto-settle)
After=network-online.target
[Service]
User=boxd
WorkingDirectory=/home/boxd/backend
EnvironmentFile=/etc/x207/backend-v015.env
ExecStart=/bin/sh start.sh
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
