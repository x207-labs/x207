[Unit]
Description=x207 neardata cache (one reader of testnet.neardata.xyz for all backends on the machine)
After=network-online.target
Before=x207-backend.service x207-backend-v014.service x207-backend-v015.service
[Service]
User=boxd
WorkingDirectory=/home/boxd/keeper
Environment=NEARDATA_UPSTREAM=https://testnet.neardata.xyz
Environment=PORT=8099
ExecStart=/usr/bin/env node /home/boxd/neardata-cache.mjs
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
