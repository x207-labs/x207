# BE-121 TEMPLATE, nothing here ran on mainnet. Public values only. The appraiser key X207_APPRAISER_NEARAI_KEY is set on the machine only, never in this file.
# Fill the two <...> values after the owner has deployed the circle (docs/mainnet-runbook.md, section 13, steps M5 and M6), then copy to /etc/x207/backend-mainnet.env.
NODE_ENV=production
NEAR_RPC_PRIMARY_URL=https://rpc.mainnet.fastnear.com
NEAR_RPC_FALLBACK_URL=https://rpc.mainnet.near.org
# The circle account the owner chose (decision 1 of the runbook), for example x207-circle.near
X207_CONTRACT_ID=<circle>.near
X207_CIRCLE_ID=agents-main
# Block of the first deploy transaction of the circle minus about 80 (the value is printed by `near tx-status`; see runbook step M6)
X207_START_BLOCK=<deploy block minus 80>
X207_NO_SEED=1
X207_DB_PATH=/var/lib/x207/x207-mainnet.sqlite
# Read only: no faucet on mainnet, GET routes plus the appraiser POST (allowInReadOnly)
X207_READ_ONLY=1
# Separate frontend project (runbook 13.4); the testnet origins are NOT listed on purpose
X207_CORS_ORIGINS=https://x207-mainnet.vercel.app,http://localhost:5207
API_TRUST_PROXY=1
X207_BLOCK_SOURCE=account-index
X207_NEARDATA_URL=http://127.0.0.1:8098
X207_TX_INDEX_URL=https://tx.main.fastnear.com/v0/account
X207_MPC_CONTRACT_ID=v1.signer
# BE-120 appraiser (NEAR AI Cloud), the same model as testnet
X207_APPRAISER_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
PORT=8085
X207_INDEXER_POLL_MS=8000
