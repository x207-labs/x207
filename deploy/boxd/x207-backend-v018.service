[Unit]
Description=x207 read API and indexer of x207-v018.testnet (contract 0.0.18, sale of a NEAR account through a locker, remove_pending)
After=network-online.target
[Service]
User=boxd
WorkingDirectory=/home/boxd/backend-v018
EnvironmentFile=/etc/x207/backend-v018.env
ExecStart=/bin/sh start.sh
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
