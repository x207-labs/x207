NODE_ENV=production
NEAR_RPC_PRIMARY_URL=https://rpc.testnet.fastnear.com
NEAR_RPC_FALLBACK_URL=https://near-testnet.drpc.org
X207_CONTRACT_ID=x207-v018.testnet
X207_CIRCLE_ID=agents-main
# Block 276797567 holds the first deploy transaction of x207-v018.testnet (GFdqKPY9BH7Z83hAZX2ztekGFwv63B5UUmpYhdoC1mG1); the indexer on boxd starts 77 blocks before it (the value that runs there)
X207_START_BLOCK=276797490
X207_NO_SEED=1
X207_DB_PATH=/var/lib/x207/x207-v018.sqlite
X207_READ_ONLY=1
X207_CORS_ORIGINS=https://x207-dashboard.vercel.app
API_TRUST_PROXY=1
X207_BLOCK_SOURCE=account-index
X207_NEARDATA_URL=http://127.0.0.1:8099
X207_TX_INDEX_URL=https://tx.test.fastnear.com/v0/account
X207_MPC_CONTRACT_ID=v1.signer-prod.testnet
PORT=8084
X207_INDEXER_POLL_MS=8000
